/target/
gitleaks.sarif

# Plaintext dotenv is local-only at every depth, including common suffix variants.
*.env
*/*.env
*/**/*.env
.env.*
*.env.*
!.env.example

# Decrypted material is never tracked.
/env/dec/

# Only the two approved SOPS ciphertext files are trackable.
/env/enc/*
!/env/enc/dev.env.enc
!/env/enc/prod.env.enc

# Never commit provider key material or service-account documents.
*.pem
*.p8
*.key
*service-account*.json

# Nix and direnv local state.
.direnv/
result
result-*

# Editor, OS, and local worktree scratch.
.DS_Store
.idea/
.vscode/
tmp/worktrees
temp/worktrees
# >>> ores fleet hygiene — managed block, edits below are overwritten >>>
tmp/temp/
tmp/worktrees/
# <<< ores fleet hygiene <<<
# Sanctioned scratch locations - AGENTS.md requires both, trailing-slash form
tmp/
temp/

# machine-local symlink to ORESoftware/my-ai AGENTS.md; never committed
.ores/

# build output (DEN-3945 conformance): never tracked
target/
